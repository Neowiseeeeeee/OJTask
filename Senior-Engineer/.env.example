# Copy this file to .env for local development and fill in your own values.
# NEVER commit .env with real credentials — .env is in .gitignore.

# ── Required ───────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get this from https://cloud.mongodb.com → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Express session secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Optional ───────────────────────────────────────────────────────────────────

# Port for local development (default: 5000)
PORT=5000
NODE_ENV=development

# Gmail credentials for password-reset OTP emails
# Use an App Password, not your real Gmail password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Google OAuth (for "Continue with Google" button)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Vercel deployment notes ─────────────────────────────────────────────────────
# Add MONGODB_URI, SESSION_SECRET (and optionally GMAIL_* / GOOGLE_*) as
# Environment Variables in your Vercel project settings:
# https://vercel.com/docs/projects/environment-variables
#
# File uploads (profile pictures stored via multer) use /tmp on Vercel —
# they are ephemeral and will not persist across deployments.
# For persistent file storage consider Vercel Blob or Cloudinary.
