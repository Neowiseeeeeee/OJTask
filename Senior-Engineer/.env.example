# Copy this file to .env for local development and fill in your own values.
# NEVER commit .env with real credentials — .env is in .gitignore.

# MongoDB Atlas connection string
# Note: Use MONGODB_URI (not DATABASE_URL — Replit reserves that for its built-in PostgreSQL)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Express session secret — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

PORT=5000
NODE_ENV=development
